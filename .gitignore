# Datasets and captures — large, and regenerable from the Roboflow exports
datasets/
runs/
screenshots/
logs/
"Pokemon Go State"*.zip
*.zip

# Model artifacts. The two the bot actually loads are force-added below so a fresh
# clone can run; everything else (training runs, optimizer states) stays out.
models/
*.pt
!models/v3/det/weights/best.pt
!models/v3/cls/weights/best.pt
# models/v3/det_s/ is the larger yolov8s detector: better, but ~85 MB, which is not
# something every clone should pay for. Train it locally and adopt it with
# tools/adopt_best_detector.py --install.

__pycache__/
*.py[cod]
.DS_Store
.venv/

# Agent working files (plans, reports, ledgers)
.superpowers/

# The operator's own per-account settings; accounts.example.json is the template,
# and a real one names real accounts.
/accounts.json
